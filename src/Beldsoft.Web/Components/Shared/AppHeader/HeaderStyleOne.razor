@inject NavigationManager Nav

<header class="main-header header-style-one">

    <!-- Header Top -->
    <div class="header-top">
        <div class="auto-container">
            <div class="inner-container">
                <div class="d-flex justify-content-between align-items-center flex-wrap">
                    <div class="left-box d-flex align-items-center flex-wrap">
                        <div class="info-list_outer">
                            <ul class="header-top_list d-flex flex-wrap">
                                <li><span class="icon fa-classic fa-solid fa-envelope fa-fw"></span><a href="mailto:support@beldsoft.com">support@beldsoft.com</a></li>
                                <li><span class="icon fa-classic fa-solid fa-location-dot fa-fw"></span>Atlanta, GA, USA</li>
                            </ul>
                        </div>
                    </div>
                    <div class="right-box">Software engineering, cloud, modernization &amp; AI</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Header Lower -->
    <div class="header-lower">
        <div class="auto-container">
            <div class="inner-container">
                <div class="d-flex justify-content-between align-items-center">

                    <div class="logo-box">
                        <div class="logo"><a href="/"><img src="assets/images/logo.svg" alt="" title="Beldsoft" loading="eager" fetchpriority="high" decoding="async" /></a></div>
                    </div>

                    <div class="nav-outer d-flex flex-wrap">
                        <!-- Main Menu -->
                        <nav class="main-menu navbar-expand-md">
                            <div class="navbar-header">
                                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                                    <span class="icon-bar"></span>
                                    <span class="icon-bar"></span>
                                    <span class="icon-bar"></span>
                                </button>
                            </div>

                            <div class="navbar-collapse collapse clearfix" id="navbarSupportedContent">
                                <ul class="navigation clearfix">
                                    <li><NavLink href="/" Match="NavLinkMatch.All">Home</NavLink></li>
                                    <li><NavLink href="/about">About</NavLink></li>
                                    <li><NavLink href="/services">Services</NavLink></li>
                                    <li><NavLink href="/projects">Projects</NavLink></li>
                                    <li><NavLink href="/blog">Blog</NavLink></li>
                                    <li><NavLink href="/contact">Contact</NavLink></li>
                                </ul>
                            </div>
                        </nav>
                    </div>

                    <!-- Outer Box -->
                    <div class="outer-box d-flex align-items-center flex-wrap">

                        <!-- Button Box -->
                        <div class="main-header_button">
                            <a href="/contact" class="theme-btn btn-style-one">
                                <span class="btn-wrap">
                                    <span class="text-one">BOOK A CALL</span>
                                    <span class="text-two">BOOK A CALL</span>
                                </span>
                            </a>
                        </div>

                        <!-- Mobile Navigation Toggler -->
                        <button class="mobile-nav-toggler" type="button" aria-label="Open navigation" aria-expanded="false">
                            <span class="icon fa-classic fa-solid fa-bars fa-fw" aria-hidden="true"></span>
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- End Header Lower -->

    <!-- Mobile Menu -->
    <div class="mobile-menu">
        <div class="menu-backdrop"></div>
        <button class="close-btn" type="button" aria-label="Close navigation"><span class="icon fa-xmark" aria-hidden="true"></span></button>

        <nav class="menu-box">
            <div class="nav-logo"><a href="/"><img src="assets/images/logo.svg" alt="" title="Beldsoft" loading="eager" fetchpriority="high" decoding="async" /></a></div>
            <div class="menu-outer"><!--Here Menu Will Come Automatically Via Javascript / Same Menu as in Header--></div>
        </nav>
    </div>
    <!-- End Mobile Menu -->

</header>
