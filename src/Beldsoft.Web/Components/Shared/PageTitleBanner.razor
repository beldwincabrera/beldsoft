<section class="page-title" style="background-image: url(/assets/images/background/3.jpg)">
    <div class="auto-container">
        <h1 class="page-title_heading">@Title</h1>
        <ul class="bread-crumb clearfix">
            @foreach (var crumb in Breadcrumbs)
            {
                @if (crumb.Href is not null)
                {
                    <li><a href="@crumb.Href">@crumb.Label</a></li>
                }
                else
                {
                    <li>@crumb.Label</li>
                }
            }
        </ul>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public BreadcrumbItem[] Breadcrumbs { get; set; } = [];

    public record BreadcrumbItem(string Label, string? Href);
}
