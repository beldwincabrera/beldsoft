<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#090c1b" />
    <meta name="format-detection" content="telephone=no" />
    <base href="/" />

    <!-- Stylesheets — identical order to original template -->
    <link href="assets/css/bootstrap.css" rel="stylesheet" />
    <link href="assets/css/global.css" rel="stylesheet" />
    <link href="assets/css/header.css" rel="stylesheet" />
    <link href="assets/css/footer.css" rel="stylesheet" />
    <link href="assets/css/font-awesome.css" rel="stylesheet" />
    <link href="assets/css/style.css" rel="stylesheet" />
    <link href="assets/css/responsive.css" rel="stylesheet" />

    <!-- Fonts: establish the connection early and request only the families used by the theme. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Outfit:wght@100..900&family=Raleway:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- MudBlazor -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- App overrides -->
    <link rel="stylesheet" href="app.css" />

    <link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon" />
    <link rel="icon" href="assets/images/favicon.png" type="image/x-icon" />
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "Organization",
          "name": "Beldsoft",
          "url": "https://beldsoft.com/",
          "logo": "https://beldsoft.com/assets/images/logo.svg",
          "email": "support@beldsoft.com",
          "description": "Software engineering, cloud, modernization, AI, and product delivery services."
        }
    </script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <BackToTop />

    <!-- Blazor -->
    <script defer src="_framework/blazor.web.js"></script>
    <script defer src="_content/MudBlazor/MudBlazor.min.js"></script>

    <!-- Native Beldsoft interactions and Blazor interop -->
    <script defer src="js/beldsoft-interop.js"></script>

</body>

</html>
