@page "/privacy-policy"
@layout Layout.MinimalLayout

<PageTitle>Privacy Policy - Beldsoft</PageTitle>

<PageTitleBanner Title="Privacy Policy"
    Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Privacy Policy",null) })" />

<section class="privacy-section section">
    <div class="auto-container">
        <div class="row clearfix">
            <div class="col-lg-10 offset-lg-1">
                <h3>Privacy Policy</h3>
                <p>Last updated: January 1, 2025</p>
                <p>At Beldsoft, we are committed to protecting your privacy. This policy explains how we collect, use, and safeguard your personal information.</p>
                <h5>Information We Collect</h5>
                <p>We collect information you provide directly to us, such as when you fill out a contact form, subscribe to our newsletter, or request our services. This may include your name, email address, phone number, and company information.</p>
                <h5>How We Use Your Information</h5>
                <p>We use your information to respond to inquiries, provide services, send relevant communications, and improve our website experience.</p>
                <h5>Data Security</h5>
                <p>We implement appropriate technical and organisational measures to protect your personal data against accidental or unlawful destruction, loss, alteration, or unauthorised access.</p>
                <h5>Contact Us</h5>
                <p>For privacy-related questions, contact us at <a href="mailto:privacy@beldsoft.com">privacy@beldsoft.com</a>.</p>
            </div>
        </div>
    </div>
</section>
