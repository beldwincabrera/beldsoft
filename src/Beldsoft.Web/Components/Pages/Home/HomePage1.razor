@page "/"
@layout Layout.MainLayout
@inject IServiceService ServiceSvc

<SeoHead Title="Beldsoft | Software Engineering & Technology Consulting"
         Description="Beldsoft helps small and medium-sized businesses design, build, modernize, integrate, and operate practical business software." Path="/" />
<HeadContent>
    <script type="application/ld+json">@((MarkupString)OrganizationSchema)</script>
</HeadContent>

<section class="hero">
    <div class="container hero-grid">
        <div>
            <span class="eyebrow">Software engineering for growing businesses</span>
            <h1>Turn operational friction into software that works for your business.</h1>
            <p class="lead">Beldsoft helps small and medium-sized organizations design, build, modernize, and integrate business software—without the overhead of a full internal engineering department.</p>
            <div class="button-row">
                <a class="button" href="/contact">Request a consultation</a>
                <a class="text-link" href="/services">Explore our services <span aria-hidden="true">→</span></a>
            </div>
            <ul class="trust-list" aria-label="What to expect">
                <li>Business-first discovery</li><li>Senior technical guidance</li><li>Maintainable delivery</li>
            </ul>
        </div>
        <div class="hero-visual" aria-label="From business challenge to reliable software">
            <div class="signal-card signal-card-main">
                <span class="signal-label">Your business</span>
                <strong>Manual work. Disconnected tools. Aging software.</strong>
            </div>
            <div class="signal-line"></div>
            <div class="signal-card signal-card-accent">
                <span class="signal-label">Beldsoft engineering</span>
                <strong>Clear plan. Purpose-built solution. Measurable progress.</strong>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">What we do</span>
            <h2>Focused capabilities for consequential software work.</h2>
            <p>Bring us the business problem. We will help define the right technical response and a practical path to delivery.</p>
        </div>
        <div class="card-grid card-grid-3">
            @foreach (var service in _services)
            {
                <article class="service-card">
                    <span class="card-number">@service.Id.ToString("00")</span>
                    <h3><a href="/services/@service.Slug">@service.Title</a></h3>
                    <p>@service.ShortDescription</p>
                    <a class="text-link" href="/services/@service.Slug" aria-label="Learn about @service.Title">View service <span aria-hidden="true">→</span></a>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-muted">
    <div class="container split">
        <div>
            <span class="eyebrow">Problems we solve</span>
            <h2>Technology should reduce complexity—not create more of it.</h2>
        </div>
        <div class="challenge-list">
            <article><h3>Critical work depends on spreadsheets and repetitive steps</h3><p>We identify where automation and purpose-built software can reduce delays and errors.</p></article>
            <article><h3>Your systems do not share information reliably</h3><p>We connect applications and data with secure, observable integrations.</p></article>
            <article><h3>An aging application limits growth</h3><p>We create an incremental modernization plan based on risk and business value.</p></article>
            <article><h3>You need senior technical direction</h3><p>We turn priorities into architecture, delivery decisions, and an actionable roadmap.</p></article>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">How we work</span>
            <h2>Clarity before code. Progress you can see.</h2>
        </div>
        <ol class="process-grid">
            <li><span>01</span><h3>Understand</h3><p>Define the business problem, users, constraints, and desired outcome.</p></li>
            <li><span>02</span><h3>Shape</h3><p>Evaluate options, reduce uncertainty, and agree on a practical delivery plan.</p></li>
            <li><span>03</span><h3>Build</h3><p>Deliver in reviewable increments with quality, security, and maintainability in mind.</p></li>
            <li><span>04</span><h3>Improve</h3><p>Launch responsibly, measure results, and prioritize what should come next.</p></li>
        </ol>
    </div>
</section>

<section class="cta-band">
    <div class="container cta-inner">
        <div><span class="eyebrow">Start with a conversation</span><h2>What is slowing your business down?</h2><p>Tell us what is not working and what a better outcome would look like.</p></div>
        <a class="button button-light" href="/contact">Discuss your project</a>
    </div>
</section>

@code {
    private const string OrganizationSchema = """
        {
          "@context": "https://schema.org",
          "@type": "ProfessionalService",
          "name": "Beldsoft",
          "url": "https://beldsoft.com/",
          "email": "hello@beldsoft.com",
          "description": "Software engineering and technology consulting for small and medium-sized businesses.",
          "serviceType": [
            "Custom software development",
            "Software modernization",
            "Software architecture",
            "API and systems integration",
            "Workflow automation",
            "Cloud and DevOps consulting"
          ]
        }
        """;
    private IEnumerable<ServiceDto> _services = [];
    protected override async Task OnInitializedAsync() => _services = await ServiceSvc.GetServicesAsync();
}
