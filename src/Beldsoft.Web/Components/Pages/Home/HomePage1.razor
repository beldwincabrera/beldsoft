@page "/"
@layout Layout.MainLayout
@inject IServiceService ServiceSvc

<SeoHead Title="Beldsoft | Software Engineering & Technology Consulting"
         Description="Beldsoft helps small and medium-sized businesses design, build, modernize, integrate, and operate practical business software." Path="/" />
<HeadContent>
    <script type="application/ld+json">@((MarkupString)OrganizationSchema)</script>
    <link rel="preload" as="image" href="/assets/images/main-slider/1.jpg" fetchpriority="high" />
</HeadContent>

<section class="hero-carousel-shell" aria-label="Beldsoft capabilities">
    <MudCarousel TData="HeroSlide"
                 Class="hero-carousel"
                 AutoCycle="@_autoCycle"
                 AutoCycleTime="@TimeSpan.FromSeconds(7)"
                 ShowArrows="true"
                 ShowBullets="true"
                 EnableSwipeGesture="true"
                 ArrowsColor="Color.Inherit"
                 BulletsColor="Color.Inherit"
                 NavigationButtonsClass="hero-carousel-arrow"
                 BulletsClass="hero-carousel-bullets">
        @foreach (var slide in HeroSlides)
        {
            <MudCarouselItem Transition="Transition.Fade">
                <div class="hero" style="@HeroStyle(slide)">
                    <div class="container hero-grid">
                        <div class="hero-content">
                            <span class="eyebrow">@slide.Eyebrow</span>
                            @if (slide.IsPrimary)
                            {
                                <h1 class="hero-title">
                                    <span class="hero-title-primary">@slide.Title</span>
                                    <span class="hero-title-accent">@slide.AccentTitle</span>
                                </h1>
                            }
                            else
                            {
                                <h2 class="hero-title">
                                    <span class="hero-title-primary">@slide.Title</span>
                                    <span class="hero-title-accent">@slide.AccentTitle</span>
                                </h2>
                            }
                            <p class="lead">@slide.Description</p>
                            <div class="button-row">
                                <a class="button" href="@slide.PrimaryHref">@slide.PrimaryAction</a>
                                <a class="text-link" href="@slide.SecondaryHref">@slide.SecondaryAction <span aria-hidden="true">→</span></a>
                            </div>
                            <ul class="trust-list" aria-label="What to expect">
                                @foreach (var point in slide.TrustPoints)
                                {
                                    <li>@point</li>
                                }
                            </ul>
                        </div>
                        <div class="hero-image-space" aria-hidden="true"></div>
                    </div>
                </div>
            </MudCarouselItem>
        }
    </MudCarousel>
    <button class="hero-carousel-pause"
            type="button"
            @onclick="ToggleAutoCycle"
            aria-label="@(_autoCycle ? "Pause hero carousel" : "Play hero carousel")">
        <span aria-hidden="true">@(_autoCycle ? "Ⅱ" : "▶")</span>
        <span>@(_autoCycle ? "Pause" : "Play")</span>
    </button>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">What we do</span>
            <h2>Focused capabilities for consequential software work.</h2>
            <p>Bring us the business problem. We will help define the right technical response and a practical path to delivery.</p>
        </div>
        <div class="card-grid card-grid-3">
            @foreach (var service in _services)
            {
                <article class="service-card">
                    <span class="card-number">@service.Id.ToString("00")</span>
                    <h3><a href="/services/@service.Slug">@service.Title</a></h3>
                    <p>@service.ShortDescription</p>
                    <a class="text-link" href="/services/@service.Slug" aria-label="Learn about @service.Title">View service <span aria-hidden="true">→</span></a>
                </article>
            }
        </div>
    </div>
</section>

<section class="section section-muted">
    <div class="container split">
        <div>
            <span class="eyebrow">Problems we solve</span>
            <h2>Technology should reduce complexity—not create more of it.</h2>
        </div>
        <div class="challenge-list">
            <article><h3>Critical work depends on spreadsheets and repetitive steps</h3><p>We identify where automation and purpose-built software can reduce delays and errors.</p></article>
            <article><h3>Your systems do not share information reliably</h3><p>We connect applications and data with secure, observable integrations.</p></article>
            <article><h3>An aging application limits growth</h3><p>We create an incremental modernization plan based on risk and business value.</p></article>
            <article><h3>You need senior technical direction</h3><p>We turn priorities into architecture, delivery decisions, and an actionable roadmap.</p></article>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">How we work</span>
            <h2>Clarity before code. Progress you can see.</h2>
        </div>
        <ol class="process-grid">
            <li><span>01</span><h3>Understand</h3><p>Define the business problem, users, constraints, and desired outcome.</p></li>
            <li><span>02</span><h3>Shape</h3><p>Evaluate options, reduce uncertainty, and agree on a practical delivery plan.</p></li>
            <li><span>03</span><h3>Build</h3><p>Deliver in reviewable increments with quality, security, and maintainability in mind.</p></li>
            <li><span>04</span><h3>Improve</h3><p>Launch responsibly, measure results, and prioritize what should come next.</p></li>
        </ol>
    </div>
</section>

<section class="cta-band">
    <div class="container cta-inner">
        <div><span class="eyebrow">Start with a conversation</span><h2>What is slowing your business down?</h2><p>Tell us what is not working and what a better outcome would look like.</p></div>
        <a class="button button-light" href="/contact">Discuss your project</a>
    </div>
</section>

@code {
    private const string OrganizationSchema =
        "{\"\\u0040context\":\"https://schema.org\",\"\\u0040type\":\"ProfessionalService\"," +
        "\"name\":\"Beldsoft\",\"url\":\"https://beldsoft.com/\",\"email\":\"support@beldsoft.com\"," +
        "\"description\":\"Software engineering and technology consulting for small and medium-sized businesses.\"," +
        "\"serviceType\":[\"Custom software development\",\"Software modernization\",\"Software architecture\"," +
        "\"API and systems integration\",\"Workflow automation\",\"Cloud and DevOps consulting\"]}";

    private static readonly HeroSlide[] HeroSlides =
    [
        // Heading names a concrete moment (the workaround) instead of a generic claim ("software that works") so it's recognizable to a prospect, not interchangeable with any dev shop.
        new(
            "Software engineering for growing businesses",
            "Replace the workaround with",
            "the system it deserves.",
            "Beldsoft helps small and medium-sized organizations design, build, modernize, and integrate business software—without the overhead of a full internal engineering department.",
            "/assets/images/main-slider/1.jpg",
            "Request a consultation",
            "/contact",
            "Explore our services",
            "/services",
            ["Business-first discovery", "Senior technical guidance", "Maintainable delivery"],
            true),
        // Heading pre-empts the "just rewrite it" assumption and reframes modernization as a staged plan, matching the Software Modernization service positioning.
        new(
            "Modernization without unnecessary disruption",
            "Your legacy app doesn't need a rewrite.",
            "It needs a plan.",
            "Reduce the cost and risk of aging applications through practical, staged improvements that protect business continuity and make future change easier.",
            "/assets/images/main-slider/2.jpg",
            "Discuss modernization",
            "/contact?service=software-modernization",
            "See our approach",
            "/services/software-modernization",
            ["Incremental roadmap", "Lower delivery risk", "Reliable operations"],
            false),
        // Heading names a specific, visible symptom (duplicate data entry) rather than an abstract outcome, matching the APIs & Systems Integration / Workflow Automation & Applied AI service positioning.
        new(
            "Connected operations and responsible automation",
            "Stop re-entering the same data",
            "into three systems.",
            "Connect disconnected systems and apply automation or AI where it can reduce repetitive effort, improve visibility, and support better decisions.",
            "/assets/images/main-slider/3.jpg",
            "Discuss your workflow",
            "/contact?service=workflow-automation-ai",
            "Explore automation and AI",
            "/services/workflow-automation-ai",
            ["Secure integrations", "Human-centered controls", "Measurable outcomes"],
            false)
    ];

    private IEnumerable<ServiceDto> _services = [];
    private bool _autoCycle = true;

    private static string HeroStyle(HeroSlide slide) =>
        $"--hero-image: url('{slide.Image}')";

    private void ToggleAutoCycle() => _autoCycle = !_autoCycle;

    protected override async Task OnInitializedAsync() => _services = await ServiceSvc.GetServicesAsync();

    private sealed record HeroSlide(
        string Eyebrow,
        string Title,
        string AccentTitle,
        string Description,
        string Image,
        string PrimaryAction,
        string PrimaryHref,
        string SecondaryAction,
        string SecondaryHref,
        string[] TrustPoints,
        bool IsPrimary);
}
