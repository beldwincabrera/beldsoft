@page "/services"
@layout Layout.MainLayout
@inject IServiceService ServiceSvc

<PageTitle>Software Engineering Services | Beldsoft</PageTitle>

<PageTitleBanner Title="Our Services"
    Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Services",null) })" />

<section class="services-one services-page">
    <div class="auto-container">
        <SectionTitle Tag="What We Do"
                      Title="Engineering capabilities for every stage of the product lifecycle"
                      Class="text-center" />
        <div class="row clearfix">
            @foreach (var svc in _services)
            {
                <div class="col-lg-4 col-md-6">
                    <ServiceCard Service="svc" />
                </div>
            }
        </div>
    </div>
</section>

<CtaSection Tag="Not sure where to begin?"
            Title="We'll help identify the highest-value next step."
            ButtonText="Discuss your challenge"
            ButtonHref="/contact" />

@code {
    private IEnumerable<ServiceDto> _services = [];
    protected override async Task OnInitializedAsync() =>
        _services = await ServiceSvc.GetServicesAsync();
}
