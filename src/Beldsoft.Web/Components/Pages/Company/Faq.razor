@page "/faq"
@layout Layout.MainLayout
@inject IFaqService FaqSvc

<PageTitle>Software Development FAQ | Beldsoft</PageTitle>

<PageTitleBanner Title="Frequently Asked Questions"
    Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("FAQ",null) })" />

<section class="faq-section section">
    <div class="auto-container">
        <SectionTitle Tag="Working with Beldsoft" Title="Answers to common questions" Class="text-center" />
        <div class="row clearfix">
            <div class="col-lg-8 offset-lg-2">
                <MudExpansionPanels MultiExpansion="false">
                    @foreach (var faq in _faqs)
                    {
                        <MudExpansionPanel Text="@faq.Question">
                            <p>@faq.Answer</p>
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>
        </div>
    </div>
</section>

<CtaSection />

@code {
    private IEnumerable<FaqItemDto> _faqs = [];
    protected override async Task OnInitializedAsync() =>
        _faqs = await FaqSvc.GetFaqItemsAsync();
}
