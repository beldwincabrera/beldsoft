@page "/services/{Slug}"
@layout Layout.MainLayout
@inject IServiceService ServiceSvc
@inject NavigationManager Nav

<PageTitle>@(_service?.Title ?? "Service") - Beldsoft</PageTitle>

@if (_service is null)
{
    <PageTitleBanner Title="Service Not Found"
        Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Services","/services") })" />
    <section class="section"><div class="auto-container"><p>Service not found.</p></div></section>
}
else
{
    <PageTitleBanner Title="@_service.Title"
        Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Services","/services"), new Shared.PageTitleBanner.BreadcrumbItem(_service.Title,null) })" />

    <section class="service-detail section">
        <div class="auto-container">
            <div class="row clearfix">
                <div class="col-lg-8 col-md-12">
                    <div class="service-detail_image">
                        <img src="/@_service.Image" alt="@_service.Title" loading="lazy" decoding="async" />
                    </div>
                    <h2>@_service.Title</h2>
                    <p>@_service.Description</p>
                    @if (_service.Features.Any())
                    {
                        <h4>Key Features</h4>
                        <ul class="service-features">
                            @foreach (var f in _service.Features)
                            {
                                <li><span class="fa-solid fa-check"></span> @f</li>
                            }
                        </ul>
                    }
                </div>
                <div class="col-lg-4 col-md-12">
                    <div class="service-sidebar">
                        <div class="sidebar-widget">
                            <h4>All Services</h4>
                            <ul class="service-list">
                                @foreach (var svc in _allServices)
                                {
                                    <li class="@(svc.Slug == Slug ? "active" : "")">
                                        <a href="/services/@svc.Slug">@svc.Title</a>
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="sidebar-cta">
                            <h4>Need Help?</h4>
                            <a href="/contact" class="theme-btn btn-style-one"><span class="btn-title">Contact Us</span></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private ServiceDto? _service;
    private IEnumerable<ServiceDto> _allServices = [];

    protected override async Task OnInitializedAsync()
    {
        _allServices = await ServiceSvc.GetServicesAsync();
        _service = await ServiceSvc.GetServiceBySlugAsync(Slug);
    }
}
