@page "/blog/{Slug}"
@layout Layout.MainLayout
@inject IBlogService BlogSvc

<SeoHead Title="@Title" Description="@Description" Path="@($"/blog/{Slug}")" NoIndex="@(_post is null)" />

@if (_post is null)
{
    <section class="page-hero compact"><div class="container narrow"><span class="eyebrow">Insight not found</span><h1>That article is not available.</h1><p class="lead">Browse the current Beldsoft insights instead.</p><a class="button" href="/blog">View all insights</a></div></section>
}
else
{
    <article>
        <header class="article-hero">
            <div class="container article-heading">
                <a class="back-link" href="/blog">← All insights</a>
                <div class="insight-meta">
                    <span>@_post.Categories.FirstOrDefault()</span>
                    <time datetime="@_post.PublishedAt.ToString("yyyy-MM-dd")">@_post.PublishedAt.ToString("MMMM d, yyyy")</time>
                    <span>@ReadTime min read</span>
                </div>
                <h1>@_post.Title</h1>
                <p class="lead">@_post.Excerpt</p>
            </div>
        </header>
        <div class="article-layout container">
            <aside class="article-aside">
                <span class="eyebrow">In this insight</span>
                <p>Business context, decision criteria, implementation risk, and a practical next step.</p>
                <a class="text-link" href="/contact">Discuss your situation <span aria-hidden="true">→</span></a>
            </aside>
            <div class="article-prose">@((MarkupString)_post.Content)</div>
        </div>
    </article>
    <section class="cta-band"><div class="container cta-inner"><div><span class="eyebrow">Turn insight into action</span><h2>Define the right next move.</h2></div><a class="button button-light" href="/contact">Talk with Beldsoft</a></div></section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private BlogPostDto? _post;
    private string Title => _post is null ? "Insight Not Found | Beldsoft" : $"{_post.Title} | Beldsoft";
    private string Description => _post?.Excerpt ?? "The requested Beldsoft insight could not be found.";
    private int ReadTime => _post is null ? 0 : Math.Max(3, _post.Content.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length / 200);
    protected override async Task OnParametersSetAsync() => _post = await BlogSvc.GetPostBySlugAsync(Slug);
}
