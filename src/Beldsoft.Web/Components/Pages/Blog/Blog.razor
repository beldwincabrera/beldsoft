@page "/blog"
@layout Layout.MainLayout
@inject IBlogService BlogSvc

<SeoHead Title="Software Engineering Insights | Beldsoft"
         Description="Practical guidance for custom software, modernization, systems integration, workflow automation, applied AI, cloud, and technology decisions." Path="/blog" />

<section class="page-hero">
    <div class="container page-hero-inner">
        <div>
            <span class="eyebrow">Beldsoft insights</span>
            <h1>Practical thinking for better software decisions.</h1>
        </div>
        <p class="lead">Clear, business-focused guidance for leaders evaluating software, modernization, integration, automation, and AI.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="insights-intro">
            <div>
                <span class="eyebrow">Latest perspectives</span>
                <h2>Make the decision before selecting the technology.</h2>
            </div>
            <p>These articles are written to help growing organizations evaluate tradeoffs, reduce delivery risk, and invest in technology with a clearer business case.</p>
        </div>
        <div class="insight-grid">
            @foreach (var post in _posts)
            {
                <article class="insight-card">
                    <div class="insight-meta">
                        <span>@post.Categories.FirstOrDefault()</span>
                        <time datetime="@post.PublishedAt.ToString("yyyy-MM-dd")">@post.PublishedAt.ToString("MMM d, yyyy")</time>
                    </div>
                    <h2><a href="/blog/@post.Slug">@post.Title</a></h2>
                    <p>@post.Excerpt</p>
                    <a class="text-link" href="/blog/@post.Slug" aria-label="Read @post.Title">Read insight <span aria-hidden="true">→</span></a>
                </article>
            }
        </div>
    </div>
</section>

<section class="cta-band"><div class="container cta-inner"><div><span class="eyebrow">Have a specific challenge?</span><h2>Apply the thinking to your business.</h2><p>Start with a focused conversation about the outcome, constraints, and next decision.</p></div><a class="button button-light" href="/contact">Request a consultation</a></div></section>

@code {
    private IEnumerable<BlogPostSummaryDto> _posts = [];
    protected override async Task OnInitializedAsync() => _posts = await BlogSvc.GetPostsAsync();
}
