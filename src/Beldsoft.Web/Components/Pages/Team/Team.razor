@page "/team"
@layout Layout.MainLayout
@inject ITeamService TeamSvc

<PageTitle>Our Team - Beldsoft</PageTitle>

<PageTitleBanner Title="Our Team"
    Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Team",null) })" />

<section class="team-page section">
    <div class="auto-container">
        <SectionTitle Tag="Our Experts" Title="Meet the People Behind Beldsoft" Class="text-center" />
        <div class="row clearfix">
            @foreach (var m in _members)
            {
                <div class="col-lg-3 col-md-6">
                    <TeamCard Member="m" />
                </div>
            }
        </div>
    </div>
</section>

<CtaSection />

@code {
    private IEnumerable<TeamMemberDto> _members = [];
    protected override async Task OnInitializedAsync() =>
        _members = await TeamSvc.GetMembersAsync();
}
