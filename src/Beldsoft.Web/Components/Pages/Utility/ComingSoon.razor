@page "/coming-soon"
@layout Layout.FullWidthLayout
@inject IJSRuntime JS

<PageTitle>Coming Soon - Beldsoft</PageTitle>

<section class="coming-soon-section" style="min-height:100vh; display:flex; align-items:center; justify-content:center; background: linear-gradient(135deg, #000DFF 0%, #C115EC 100%);">
    <div class="auto-container text-center" style="color:white;">
        <div class="coming-soon-logo">
            <img src="/assets/images/logo.svg" alt="Beldsoft" style="max-width:200px; margin-bottom:2rem;" />
        </div>
        <h1 style="font-size:3rem; margin-bottom:1rem;">We're Coming Soon</h1>
        <p style="font-size:1.2rem; opacity:0.8; margin-bottom:2rem;">Something awesome is in the works. Stay tuned!</p>
        <div class="countdown d-flex justify-content-center" style="gap:2rem; margin-bottom:3rem;">
            <div class="countdown-item" style="text-align:center;">
                <span style="font-size:3rem; font-weight:700;">@_days</span>
                <div>Days</div>
            </div>
            <div class="countdown-item" style="text-align:center;">
                <span style="font-size:3rem; font-weight:700;">@_hours</span>
                <div>Hours</div>
            </div>
            <div class="countdown-item" style="text-align:center;">
                <span style="font-size:3rem; font-weight:700;">@_minutes</span>
                <div>Minutes</div>
            </div>
            <div class="countdown-item" style="text-align:center;">
                <span style="font-size:3rem; font-weight:700;">@_seconds</span>
                <div>Seconds</div>
            </div>
        </div>
        <div class="newsletter-form d-flex justify-content-center" style="gap:0.5rem;">
            <MudTextField @bind-Value="_email" Placeholder="Your email address" Variant="Variant.Outlined"
                          Style="background:white; border-radius:4px; min-width:280px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" @onclick="Subscribe">Notify Me</MudButton>
        </div>
    </div>
</section>

@code {
    private string _email = string.Empty;
    private static readonly DateTime _launchDate = new(2027, 12, 31);
    private int _days, _hours, _minutes, _seconds;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        UpdateCountdown(null);
        _timer = new System.Threading.Timer(UpdateCountdown, null, TimeSpan.Zero, TimeSpan.FromSeconds(1));
    }

    private void UpdateCountdown(object? _)
    {
        var remaining = _launchDate - DateTime.Now;
        if (remaining <= TimeSpan.Zero) { _days = _hours = _minutes = _seconds = 0; return; }
        _days = remaining.Days;
        _hours = remaining.Hours;
        _minutes = remaining.Minutes;
        _seconds = remaining.Seconds;
        InvokeAsync(StateHasChanged);
    }

    private void Subscribe() => _email = string.Empty;

    public void Dispose() => _timer?.Dispose();
}
