@page "/404"
@layout Layout.MinimalLayout

<PageTitle>Page Not Found - Beldsoft</PageTitle>

<section class="error-section">
    <div class="auto-container">
        <div class="inner-container">
            <div class="image-box">
                <img src="assets/images/resource/error.png" alt="" />
            </div>
            <h2>Oops! Page Not Found</h2>
            <div class="text">The page you're looking for doesn't exist or has been moved.</div>
            <div class="link-box">
                <a href="/" class="theme-btn btn-style-one">
                    <span class="btn-wrap">
                        <span class="text-one">Back to Home</span>
                        <span class="text-two">Back to Home</span>
                    </span>
                </a>
                <a href="/contact" class="theme-btn btn-style-two">
                    <span class="btn-wrap">
                        <span class="text-one">Contact Us</span>
                        <span class="text-two">Contact Us</span>
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>
