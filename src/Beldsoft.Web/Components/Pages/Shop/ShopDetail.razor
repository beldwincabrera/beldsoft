@page "/shop/{Slug}"
@layout Layout.MainLayout
@inject IProductService ProductSvc
@inject ICartService CartSvc
@inject ISnackbar Snackbar

<PageTitle>@(_product?.Name ?? "Product") - Beldsoft</PageTitle>

@if (_product is null)
{
    <PageTitleBanner Title="Product"
        Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Shop","/shop") })" />
    <section class="section"><div class="auto-container"><p>Product not found.</p></div></section>
}
else
{
    <PageTitleBanner Title="@_product.Name"
        Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Shop","/shop"), new Shared.PageTitleBanner.BreadcrumbItem(_product.Name,null) })" />

    <section class="shop-detail section">
        <div class="auto-container">
            <div class="row clearfix">
                <div class="col-lg-6 col-md-12">
                    <div class="product-detail_image">
                        <img src="/@(_product.Images.FirstOrDefault() ?? "")" alt="@_product.Name" loading="lazy" decoding="async" />
                    </div>
                </div>
                <div class="col-lg-6 col-md-12">
                    <div class="product-detail_info">
                        <div class="product-category">@_product.Category</div>
                        <h2>@_product.Name</h2>
                        <StarRating Rating="@((int)Math.Round(_product.Rating))" />
                        <div class="product-price">
                            @if (_product.SalePrice.HasValue)
                            {
                                <span class="sale">$@_product.SalePrice.Value.ToString("0.00")</span>
                                <span class="original">$@_product.Price.ToString("0.00")</span>
                            }
                            else
                            {
                                <span>$@_product.Price.ToString("0.00")</span>
                            }
                        </div>
                        <p>@_product.Description</p>
                        <div class="quantity-selector d-flex align-items-center">
                            <button @onclick="DecQty" class="qty-btn">-</button>
                            <span class="qty">@_qty</span>
                            <button @onclick="IncQty" class="qty-btn">+</button>
                        </div>
                        <button class="theme-btn btn-style-one" @onclick="AddToCart">
                            <span class="btn-title">Add to Cart</span>
                        </button>
                        <div class="product-meta">
                            <span>Stock: @_product.StockQuantity available</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private ProductDto? _product;
    private int _qty = 1;

    protected override async Task OnInitializedAsync() =>
        _product = await ProductSvc.GetProductBySlugAsync(Slug);

    private void IncQty() => _qty++;
    private void DecQty() { if (_qty > 1) _qty--; }

    private void AddToCart()
    {
        if (_product is null) return;
        CartSvc.AddItem(_product, _qty);
        Snackbar.Add($"{_product.Name} added to cart!", Severity.Success);
    }
}
