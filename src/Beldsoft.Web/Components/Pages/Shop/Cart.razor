@page "/cart"
@layout Layout.MainLayout
@inject ICartService CartSvc
@implements IDisposable

<PageTitle>Shopping Cart - Beldsoft</PageTitle>

<PageTitleBanner Title="Shopping Cart"
    Breadcrumbs="@(new[] { new Shared.PageTitleBanner.BreadcrumbItem("Home","/"), new Shared.PageTitleBanner.BreadcrumbItem("Cart",null) })" />

<section class="cart-page section">
    <div class="auto-container">
        @if (!CartSvc.Cart.Items.Any())
        {
            <div class="empty-cart text-center" style="padding:4rem 0;">
                <span class="fa-solid fa-cart-shopping fa-3x" style="color:#ccc;"></span>
                <h3>Your cart is empty</h3>
                <a href="/shop" class="theme-btn btn-style-one"><span class="btn-title">Continue Shopping</span></a>
            </div>
        }
        else
        {
            <div class="row clearfix">
                <div class="col-lg-8 col-md-12">
                    <table class="cart-table table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Qty</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in CartSvc.Cart.Items)
                            {
                                var currentItem = item;
                                <tr>
                                    <td>
                                        <img src="/@currentItem.ProductImage" alt="@currentItem.ProductName" style="width:60px;margin-right:8px;" />
                                        @currentItem.ProductName
                                    </td>
                                    <td>$@currentItem.UnitPrice.ToString("0.00")</td>
                                    <td>
                                        <MudNumericField T="int" Value="currentItem.Quantity"
                                                         ValueChanged="qty => UpdateQty(currentItem.ProductId, qty)"
                                                         Min="1" Style="width:80px;" />
                                    </td>
                                    <td>$@currentItem.LineTotal.ToString("0.00")</td>
                                    <td>
                                        <button @onclick="() => Remove(currentItem.ProductId)" style="background:none;border:none;cursor:pointer;color:red;">
                                            <span class="fa-solid fa-xmark"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="col-lg-4 col-md-12">
                    <div class="cart-totals" style="background:#f8f8f8;padding:2rem;border-radius:8px;">
                        <h4>Order Summary</h4>
                        <div class="d-flex justify-content-between mb-2"><span>Subtotal:</span><span>$@CartSvc.Cart.Subtotal.ToString("0.00")</span></div>
                        <div class="d-flex justify-content-between mb-2"><span>Shipping:</span><span>Free</span></div>
                        <hr />
                        <div class="d-flex justify-content-between mb-3"><strong>Total:</strong><strong>$@CartSvc.Cart.Total.ToString("0.00")</strong></div>
                        <a href="/checkout" class="theme-btn btn-style-one d-block text-center"><span class="btn-title">Proceed to Checkout</span></a>
                        <a href="/shop" class="d-block text-center mt-2">Continue Shopping</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    protected override void OnInitialized() =>
        CartSvc.OnCartChanged += StateChangedHandler;

    private void StateChangedHandler() => InvokeAsync(StateHasChanged);
    private void Remove(int id) => CartSvc.RemoveItem(id);
    private void UpdateQty(int id, int qty) => CartSvc.UpdateQuantity(id, qty);
    public void Dispose() => CartSvc.OnCartChanged -= StateChangedHandler;
}
