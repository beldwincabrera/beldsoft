@page "/contact"
@layout Layout.MainLayout
@using System.ComponentModel.DataAnnotations
@inject ILeadService LeadSvc
@inject NavigationManager Navigation

<SeoHead Title="Request a Software Consultation | Beldsoft"
         Description="Tell Beldsoft about your software, modernization, integration, automation, AI, cloud, or technical leadership needs." Path="/contact" />

<section class="page-hero">
    <div class="container page-hero-inner">
        <div><span class="eyebrow">Request a consultation</span><h1>What does the business need technology to solve?</h1></div>
        <p class="lead">Share the challenge, who it affects, and what a successful outcome would look like. Beldsoft will review your consultation request and follow up by email. Add more detail if you already know your preferences or timeline.</p>
    </div>
</section>

<section class="section">
    <div class="container contact-grid">
        <aside class="contact-aside">
            <span class="eyebrow">A useful first message</span>
            <h2>Help us understand the situation.</h2>
            <ul class="check-list">
                <li>What is not working today?</li>
                <li>Who uses or depends on the process?</li>
                <li>Which systems are involved?</li>
                <li>What outcome matters most?</li>
            </ul>
            <p class="small"><strong>Start with your name, email, and the problem you need to solve. Fields marked with an asterisk (*) are required.</strong></p>
            <p>Prefer email? Write to <a href="mailto:support@beldsoft.com">support@beldsoft.com</a>.</p>
        </aside>
        <div class="form-panel">
            @if (_submitted)
            {
                <div class="status-message success" role="status" tabindex="-1" @ref="_successPanel">
                    <span class="eyebrow">Request received</span>
                    <h2>Thank you. Your consultation request was accepted.</h2>
                    <p>We will review the details and follow up using the contact information you provided.</p>
                    <a class="text-link" href="/">Return home <span aria-hidden="true">→</span></a>
                </div>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="SubmitAsync" OnInvalidSubmit="HandleInvalidSubmitAsync" FormName="consultation-request" autocomplete="off">
                    <DataAnnotationsValidator />
                    <div class="validation-summary-container" role="alert" tabindex="-1" @ref="_validationSummary">
                        <ValidationSummary class="validation-summary" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="status-message error" role="alert">@_error</div>
                    }
                    <div class="lead-form-sections">
                        <fieldset class="form-section">
                            <legend>Start with the essentials</legend>
                            <div class="form-grid">
                                <div class="field"><label for="full-name">Full name <span class="required-marker" aria-hidden="true">*</span></label><InputText id="full-name" @bind-Value="_form.Name" autocomplete="name" aria-required="true" /><ValidationMessage For="@(() => _form.Name)" /></div>
                                <div class="field"><label for="email">Email address <span class="required-marker" aria-hidden="true">*</span></label><InputText id="email" type="email" @bind-Value="_form.Email" autocomplete="email" aria-required="true" /><ValidationMessage For="@(() => _form.Email)" /></div>
                                <div class="field field-full"><label for="message">What's the problem? <span class="required-marker" aria-hidden="true">*</span></label><InputTextArea id="message" @bind-Value="_form.Message" rows="7" placeholder="Describe the current situation, the desired outcome, and any important timing or system constraints." aria-required="true" aria-describedby="message-help" /><span id="message-help" class="field-help">Please provide at least 20 characters. Do not include passwords or sensitive personal information.</span><ValidationMessage For="@(() => _form.Message)" /></div>
                            </div>
                        </fieldset>

                        <div class="additional-details-toggle">
                            <button class="detail-toggle" type="button"
                                    aria-expanded="@(_showAdditionalDetails ? "true" : "false")"
                                    aria-controls="additional-lead-details"
                                    @onclick="ToggleAdditionalDetails">
                                <span aria-hidden="true">@(_showAdditionalDetails ? "−" : "+")</span>
                                @(_showAdditionalDetails ? "Hide additional details" : "Add more detail")
                            </button>
                            <p id="additional-details-help">Optional context can help us prepare, but it is not required to send your request.</p>
                        </div>

                        <fieldset id="additional-lead-details" class="form-section additional-details" hidden="@(!_showAdditionalDetails)" aria-describedby="additional-details-help">
                            <legend>Additional details <span class="optional">(optional)</span></legend>
                            <div class="form-grid">
                                <div class="field"><label for="business-name">Business or organization <span class="optional">(optional)</span></label><InputText id="business-name" @bind-Value="_form.BusinessName" autocomplete="organization" /><ValidationMessage For="@(() => _form.BusinessName)" /></div>
                                <div class="field"><label for="role">Role or job title <span class="optional">(optional)</span></label><InputText id="role" @bind-Value="_form.Role" autocomplete="organization-title" /><ValidationMessage For="@(() => _form.Role)" /></div>
                                <div class="field"><label for="phone">Phone number <span class="optional">(required for phone follow-up)</span></label><InputText id="phone" type="tel" @bind-Value="_form.Phone" autocomplete="tel" /><ValidationMessage For="@(() => _form.Phone)" /></div>
                                <div class="field"><label for="contact-method">Preferred contact method <span class="optional">(optional)</span></label><InputSelect id="contact-method" @bind-Value="_form.PreferredContactMethod"><option value="">No preference</option><option>Email</option><option>Phone</option></InputSelect><ValidationMessage For="@(() => _form.PreferredContactMethod)" /></div>
                                <div class="field"><label for="contact-time">Best time to contact you <span class="optional">(optional)</span></label><InputText id="contact-time" @bind-Value="_form.PreferredContactTime" placeholder="Example: Weekday mornings, Eastern Time" /><ValidationMessage For="@(() => _form.PreferredContactTime)" /></div>
                                <div class="field"><label for="service">Area of interest <span class="optional">(optional)</span></label><InputSelect id="service" @bind-Value="_form.ServiceInterest"><option value="">Select an area</option>@foreach (var option in ServiceOptions) { <option value="@option">@option</option> }</InputSelect><ValidationMessage For="@(() => _form.ServiceInterest)" /></div>
                                <div class="field"><label for="timeline">Expected timeline <span class="optional">(optional)</span></label><InputSelect id="timeline" @bind-Value="_form.ProjectTimeline"><option value="">Select a timeline</option><option>As soon as possible</option><option>Within 1–3 months</option><option>Within 3–6 months</option><option>More than 6 months</option><option>Exploring options</option></InputSelect><ValidationMessage For="@(() => _form.ProjectTimeline)" /></div>
                            </div>
                        </fieldset>

                        <div class="honeypot" aria-hidden="true"><label for="website">Website</label><InputText id="website" @bind-Value="_form.Website" tabindex="-1" autocomplete="new-password" data-lpignore="true" data-1p-ignore="true" /></div>
                        <div class="field checkbox-field"><InputCheckbox id="consent" @bind-Value="_form.Consent" aria-required="true" /><label for="consent">I understand Beldsoft will use this information to evaluate and respond to my request. <a href="/privacy-policy">Read the privacy notice</a>. <span class="required-marker" aria-hidden="true">*</span></label><ValidationMessage For="@(() => _form.Consent)" /></div>
                        <div class="field"><button class="button" type="submit" disabled="@_submitting" aria-busy="@_submitting">@(_submitting ? "Submitting…" : "Request a consultation")</button></div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] ServiceOptions = ["Custom software development", "Software modernization", "Architecture and technical leadership", "APIs and systems integration", "Workflow automation and applied AI", "Cloud, DevOps and reliability", "Not sure yet"];
    private static readonly HashSet<string> AdditionalDetailFields =
    [
        nameof(LeadDto.BusinessName),
        nameof(LeadDto.Role),
        nameof(LeadDto.Phone),
        nameof(LeadDto.PreferredContactMethod),
        nameof(LeadDto.PreferredContactTime),
        nameof(LeadDto.ServiceInterest),
        nameof(LeadDto.ProjectTimeline)
    ];
    private LeadDto _form = new();
    private bool _showAdditionalDetails;
    private bool _submitting;
    private bool _submitted;
    private bool _focusSuccess;
    private string? _error;
    private ElementReference _successPanel;
    private ElementReference _validationSummary;

    protected override void OnInitialized()
    {
        var currentUri = new Uri(Navigation.Uri);
        _form.SourcePage = currentUri.AbsolutePath;
        var serviceSlug = GetQueryValue(currentUri.Query, "service");
        _showAdditionalDetails = !string.IsNullOrWhiteSpace(serviceSlug);
        _form.ServiceInterest = serviceSlug switch
        {
            "custom-software-development" => "Custom software development",
            "software-modernization" => "Software modernization",
            "architecture-technical-leadership" => "Architecture and technical leadership",
            "apis-systems-integration" => "APIs and systems integration",
            "workflow-automation-ai" => "Workflow automation and applied AI",
            "cloud-devops-reliability" => "Cloud, DevOps and reliability",
            null or "" => string.Empty,
            _ => "Not sure yet"
        };
    }

    private async Task SubmitAsync()
    {
        if (_submitting) return;
        _submitting = true;
        _error = null;
        try
        {
            _submitted = await LeadSvc.SubmitLeadAsync(_form);
            _focusSuccess = _submitted;
            if (!_submitted)
                _error = "We could not accept this request. Please wait before trying again or email support@beldsoft.com.";
        }
        catch
        {
            _error = "Something went wrong while submitting the request. Please try again or email support@beldsoft.com.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task HandleInvalidSubmitAsync()
    {
        var validationResults = new List<ValidationResult>();
        _ = Validator.TryValidateObject(
            _form,
            new ValidationContext(_form),
            validationResults,
            validateAllProperties: true);

        if (validationResults.Any(
                result => result.MemberNames.Any(AdditionalDetailFields.Contains)))
        {
            _showAdditionalDetails = true;
        }

        await _validationSummary.FocusAsync();
    }

    private void ToggleAdditionalDetails() =>
        _showAdditionalDetails = !_showAdditionalDetails;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSuccess)
        {
            _focusSuccess = false;
            await _successPanel.FocusAsync();
        }
    }

    private static string? GetQueryValue(string query, string key)
    {
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length > 0 &&
                string.Equals(Uri.UnescapeDataString(parts[0]), key, StringComparison.OrdinalIgnoreCase))
            {
                return parts.Length == 2 ? Uri.UnescapeDataString(parts[1].Replace('+', ' ')) : string.Empty;
            }
        }

        return null;
    }
}
