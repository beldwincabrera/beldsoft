@page "/contact"
@layout Layout.MainLayout
@inject IContactService ContactSvc
@inject NavigationManager Navigation

<SeoHead Title="Request a Software Consultation | Beldsoft"
         Description="Tell Beldsoft about your software, modernization, integration, automation, AI, cloud, or technical leadership needs." Path="/contact" />

<section class="page-hero">
    <div class="container page-hero-inner">
        <div><span class="eyebrow">Request a consultation</span><h1>What does the business need technology to solve?</h1></div>
        <p class="lead">Share the challenge, who it affects, and what a successful outcome would look like. We will review the request and respond using your preferred contact method.</p>
    </div>
</section>

<section class="section">
    <div class="container contact-grid">
        <aside class="contact-aside">
            <span class="eyebrow">A useful first message</span>
            <h2>Help us understand the situation.</h2>
            <ul class="check-list">
                <li>What is not working today?</li>
                <li>Who uses or depends on the process?</li>
                <li>Which systems are involved?</li>
                <li>What outcome matters most?</li>
            </ul>
            <p>Prefer email? Write to <a href="mailto:hello@beldsoft.com">hello@beldsoft.com</a>.</p>
        </aside>
        <div class="form-panel">
            @if (_submitted)
            {
                <div class="status-message success" role="status" tabindex="-1">
                    <span class="eyebrow">Request received</span>
                    <h2>Thank you. Your consultation request was accepted.</h2>
                    <p>We will review the details and follow up using your preferred contact method.</p>
                    <a class="text-link" href="/">Return home <span aria-hidden="true">→</span></a>
                </div>
            }
            else
            {
                <EditForm Model="_form" OnValidSubmit="SubmitAsync" FormName="consultation-request">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="validation-summary" />
                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <div class="status-message error" role="alert">@_error</div>
                    }
                    <div class="form-grid">
                        <div class="field"><label for="full-name">Full name <span aria-hidden="true">*</span></label><InputText id="full-name" @bind-Value="_form.Name" autocomplete="name" /><ValidationMessage For="@(() => _form.Name)" /></div>
                        <div class="field"><label for="business-name">Business or organization <span aria-hidden="true">*</span></label><InputText id="business-name" @bind-Value="_form.BusinessName" autocomplete="organization" /><ValidationMessage For="@(() => _form.BusinessName)" /></div>
                        <div class="field"><label for="email">Email address <span aria-hidden="true">*</span></label><InputText id="email" type="email" @bind-Value="_form.Email" autocomplete="email" /><ValidationMessage For="@(() => _form.Email)" /></div>
                        <div class="field"><label for="phone">Phone number <span class="optional">(optional)</span></label><InputText id="phone" type="tel" @bind-Value="_form.Phone" autocomplete="tel" /><ValidationMessage For="@(() => _form.Phone)" /></div>
                        <div class="field"><label for="service">Area of interest <span aria-hidden="true">*</span></label><InputSelect id="service" @bind-Value="_form.ServiceInterest"><option value="">Select an area</option>@foreach (var option in ServiceOptions) { <option value="@option">@option</option> }</InputSelect><ValidationMessage For="@(() => _form.ServiceInterest)" /></div>
                        <div class="field"><label for="contact-method">Preferred contact method <span aria-hidden="true">*</span></label><InputSelect id="contact-method" @bind-Value="_form.PreferredContactMethod"><option value="">Select a method</option><option>Email</option><option>Phone</option></InputSelect><ValidationMessage For="@(() => _form.PreferredContactMethod)" /></div>
                        <div class="field field-full"><label for="message">Project or business challenge <span aria-hidden="true">*</span></label><InputTextArea id="message" @bind-Value="_form.Message" rows="7" placeholder="Describe the current situation, the desired outcome, and any important timing or system constraints." /><span class="field-help">Please provide at least 20 characters. Do not include passwords or sensitive personal information.</span><ValidationMessage For="@(() => _form.Message)" /></div>
                        <div class="honeypot" aria-hidden="true"><label for="website">Website</label><InputText id="website" @bind-Value="_form.Website" tabindex="-1" autocomplete="off" /></div>
                        <div class="field field-full checkbox-field"><InputCheckbox id="consent" @bind-Value="_form.Consent" /><label for="consent">I understand Beldsoft will use this information to evaluate and respond to my request. <a href="/privacy-policy">Read the privacy notice</a>. <span aria-hidden="true">*</span></label><ValidationMessage For="@(() => _form.Consent)" /></div>
                        <div class="field field-full"><button class="button" type="submit" disabled="@_submitting">@(_submitting ? "Submitting…" : "Request a consultation")</button></div>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] ServiceOptions = ["Custom software development", "Software modernization", "Architecture and technical leadership", "APIs and systems integration", "Workflow automation and applied AI", "Cloud, DevOps and reliability", "Not sure yet"];
    private ContactFormDto _form = new();
    private bool _submitting;
    private bool _submitted;
    private string? _error;

    protected override void OnInitialized()
    {
        _form.SourcePage = Navigation.Uri;
        var query = new Uri(Navigation.Uri).Query;
        if (query.Contains("service=", StringComparison.OrdinalIgnoreCase))
            _form.ServiceInterest = "Not sure yet";
    }

    private async Task SubmitAsync()
    {
        if (_submitting) return;
        _submitting = true;
        _error = null;
        try
        {
            _submitted = await ContactSvc.SubmitMessageAsync(_form);
            if (!_submitted)
                _error = "We could not accept this request. Please wait before trying again or email hello@beldsoft.com.";
        }
        catch
        {
            _error = "Something went wrong while submitting the request. Please try again or email hello@beldsoft.com.";
        }
        finally
        {
            _submitting = false;
        }
    }
}
