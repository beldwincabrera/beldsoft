@inherits LayoutComponentBase

<MudThemeProvider Theme="BeldsoftTheme.Create()" />
<MudSnackbarProvider />
<MudDialogProvider />

<div class="page-wrapper">
    <CustomCursor />
    <Preloader />
    <AboutSidebar />

    <AppHeader Variant="HeaderVariant.One" />

    @Body

    <AppFooter Variant="FooterVariant.Main" />

    <SearchPopup />
    <ColorSwitcher />
</div>
<!-- End PageWrapper -->

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#10006;</span>
</div>
