@inherits LayoutComponentBase

<MudThemeProvider Theme="BeldsoftTheme.Create()" />
<MudSnackbarProvider />
<MudDialogProvider />

<a class="skip-link" href="#main-content">Skip to main content</a>
<div class="site-shell">
    <AppHeader Variant="HeaderVariant.One" />
    <main id="main-content" tabindex="-1">
        @Body
    </main>
    <AppFooter Variant="FooterVariant.Main" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong. <a href=".">Reload the page</a>
    <button class="dismiss" type="button" aria-label="Dismiss">×</button>
</div>
