@using DomainSocialLinks = Beldsoft.Domain.Entities.SocialLinks

<ul class="social-links d-flex @Class">
    @if (Links?.Facebook is not null)
    { <li><a href="@Links.Facebook" class="fa-brands fa-facebook-f"></a></li> }
    @if (Links?.Instagram is not null)
    { <li><a href="@Links.Instagram" class="fa-brands fa-instagram"></a></li> }
    @if (Links?.Twitter is not null)
    { <li><a href="@Links.Twitter" class="fa-brands fa-x-twitter"></a></li> }
    @if (Links?.LinkedIn is not null)
    { <li><a href="@Links.LinkedIn" class="fa-brands fa-linkedin-in"></a></li> }
    @if (Links?.Dribbble is not null)
    { <li><a href="@Links.Dribbble" class="fa-brands fa-dribbble"></a></li> }
    @if (Links?.GitHub is not null)
    { <li><a href="@Links.GitHub" class="fa-brands fa-github"></a></li> }
</ul>

@code {
    [Parameter] public DomainSocialLinks? Links { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
}
