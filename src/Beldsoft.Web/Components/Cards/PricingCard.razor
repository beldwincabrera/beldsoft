<div class="price-block_one @(Plan.IsHighlighted ? "active" : "")">
    <div class="price-block_one-inner">
        <div class="price-block_one-icon">
            <img src="/@Plan.IconPath" alt="@Plan.Name" loading="lazy" decoding="async" />
        </div>
        <div class="price-block_one-name">@Plan.Name</div>
        <div class="price-block_one-subtitle">@Plan.Subtitle</div>
        <p class="price-block_one-description">@Plan.Description</p>
        <ul class="price-block_one-features">
            @foreach (var feature in Plan.Features)
            {
                <li><span class="fa-solid fa-check"></span> @feature</li>
            }
        </ul>
        <a href="/contact" class="theme-btn btn-style-one">
            <span class="btn-title">Discuss this model</span>
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PricingPlanDto Plan { get; set; } = null!;
}
