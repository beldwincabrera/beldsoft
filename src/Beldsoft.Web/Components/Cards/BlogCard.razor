<div class="news-block_one">
    <div class="news-block_one-image">
        <a href="/blog/@Post.Slug">
            <img src="/@Post.FeaturedImage" alt="@Post.Title" loading="lazy" decoding="async" />
        </a>
    </div>
    <div class="news-block_one-content">
        <ul class="news-block_one-meta">
            <li><span class="icon fa-solid fa-calendar-days"></span>@Post.PublishedAt.ToString("MMM dd, yyyy")</li>
            <li><span class="icon fa-solid fa-user"></span>@Post.Author</li>
            <li><span class="icon fa-solid fa-comment"></span>@Post.CommentCount Comments</li>
        </ul>
        <h5 class="news-block_one-title">
            <a href="/blog/@Post.Slug">@Post.Title</a>
        </h5>
        <p>@Post.Excerpt</p>
        <a href="/blog/@Post.Slug" class="news-block_one-more theme-btn">
            <span class="btn-title">Read More</span>
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public BlogPostSummaryDto Post { get; set; } = null!;
}
