<div class="testimonial-block_one">
    <div class="testimonial-block_one-inner">
        <div class="testimonial-block_one-quote"><span class="fa-solid fa-quote-right"></span></div>
        <div class="testimonial-block_one-text">@Review.Quote</div>
        <StarRating Rating="@Review.Rating" />
        <div class="testimonial-block_one-author d-flex align-items-center">
            <div class="testimonial-block_one-image">
                <img src="/assets/@Review.ClientImage" alt="@Review.ClientName" />
            </div>
            <div class="testimonial-block_one-info">
                <h6 class="testimonial-block_one-name">@Review.ClientName</h6>
                <div class="testimonial-block_one-designation">@Review.ClientTitle, @Review.ClientCompany</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public TestimonialDto Review { get; set; } = null!;
}
