<div class="service-block_one @(Variant == ServiceCardVariant.List ? "service-list" : "")">
    <div class="service-block_one-inner">
        <div class="service-block_one-icon">
            <span class="@Service.Icon"></span>
        </div>
        <div class="service-block_one-content">
            <h3 class="service-block_one-title">
                <a href="/services/@Service.Slug">@Service.Title</a>
            </h3>
            <div class="service-block_one-text">@Service.ShortDescription</div>
            @if (ShowLink)
            {
                <a href="/services/@Service.Slug" class="service-block_one-more">Read More <span class="fa fa-arrow-right"></span></a>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ServiceDto Service { get; set; } = null!;
    [Parameter] public ServiceCardVariant Variant { get; set; } = ServiceCardVariant.Box;
    [Parameter] public bool ShowLink { get; set; } = true;
}
