@inject IServiceService ServiceSvc

<section class="services-one">
    <div class="auto-container">
        <SectionTitle Tag="What We Do" Title="Engineering capabilities for every stage of the product lifecycle" Class="text-center" />
        <div class="row clearfix">
            @foreach (var svc in _services)
            {
                <div class="col-lg-4 col-md-6">
                    <ServiceCard Service="svc" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private IEnumerable<ServiceDto> _services = [];

    protected override async Task OnInitializedAsync() =>
        _services = await ServiceSvc.GetServicesAsync();
}
