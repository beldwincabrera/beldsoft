@inject IPricingService PricingSvc

<section class="pricing-one">
    <div class="auto-container">
        <SectionTitle Tag="Flexible Engagements" Title="Choose the model that fits the outcome" Class="text-center" />
        <div class="row clearfix">
            @foreach (var plan in _plans)
            {
                <div class="col-lg-4 col-md-6">
                    <PricingCard Plan="plan" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private IEnumerable<PricingPlanDto> _plans = [];
    protected override async Task OnInitializedAsync() =>
        _plans = await PricingSvc.GetPlansAsync();
}
