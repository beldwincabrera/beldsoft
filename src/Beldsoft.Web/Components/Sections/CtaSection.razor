<section class="cta-one @Class">
    <div class="auto-container">
        <div class="cta-one_inner d-flex justify-content-between align-items-center flex-wrap">
            <div class="cta-one_content">
                <div class="cta-one_title">@Tag</div>
                <h2 class="cta-one_heading">@Title</h2>
            </div>
            <div class="cta-one_button">
                <a href="@ButtonHref" class="theme-btn btn-style-one">
                    <span class="btn-title">@ButtonText</span>
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    [Parameter] public string Tag { get; set; } = "Ready to Get Started?";
    [Parameter] public string Title { get; set; } = "Let's Build Something Great Together";
    [Parameter] public string ButtonText { get; set; } = "Contact Us";
    [Parameter] public string ButtonHref { get; set; } = "/contact";
    [Parameter] public string Class { get; set; } = string.Empty;
}
