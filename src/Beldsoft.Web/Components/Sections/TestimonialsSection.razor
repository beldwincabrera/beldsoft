@inject ITestimonialService TestimonialSvc

<section class="bs-testimonials section" aria-labelledby="testimonials-title">
    <div class="auto-container">
        <div class="bs-section-heading">
            <div>
                <div class="bs-eyebrow bs-eyebrow_dark">Client perspective</div>
                <h2 id="testimonials-title">Partnerships built on clarity, ownership, and outcomes.</h2>
            </div>
            <p>Strong delivery is more than shipping features. It means understanding the business context, communicating clearly, and leaving teams stronger than we found them.</p>
        </div>

        <div class="row clearfix">
            @foreach (var testimonial in _testimonials)
            {
                <div class="col-lg-4 col-md-6">
                    <TestimonialCard Review="testimonial" />
                </div>
            }
        </div>

        <div class="bs-testimonials_action">
            <a href="/contact" class="theme-btn btn-style-one">
                <span class="btn-wrap">
                    <span class="text-one">Discuss your project</span>
                    <span class="text-two">Discuss your project</span>
                </span>
            </a>
        </div>
    </div>
</section>

@code {
    private IEnumerable<TestimonialDto> _testimonials = [];

    protected override async Task OnInitializedAsync() =>
        _testimonials = await TestimonialSvc.GetTestimonialsAsync();
}
